{
  "name": "switchyard",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestrate agent-driven software development workflows",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
